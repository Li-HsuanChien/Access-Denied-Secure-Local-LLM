{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://securelocaldocqa.local/schemas/answer/1.0.0",
  "title": "Answer",
  "description": "Question Answering result (SDD \u00a74.2, \u00a77.3). Produced by secure_qa.answering.Answer.to_dict(); tests validate it against this file.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "question",
    "status",
    "evidence_mode",
    "documents",
    "general_knowledge",
    "limitations",
    "citations",
    "evidence",
    "warnings",
    "model",
    "collection_version",
    "prompt_version",
    "timing",
    "error"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "request_id": {
      "type": "string"
    },
    "question": {
      "type": "string"
    },
    "status": {
      "enum": [
        "answered",
        "insufficient_evidence",
        "failed"
      ],
      "description": "answered: at least one cited document claim. insufficient_evidence: no document-supported section (SDD \u00a77.1). failed: see error."
    },
    "evidence_mode": {
      "enum": [
        "text",
        "visual",
        "none"
      ]
    },
    "documents": {
      "type": "array",
      "description": "'From your documents': each claim cites one or more citations.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "citation_ids"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "citation_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^S[0-9]+$"
            }
          }
        }
      }
    },
    "general_knowledge": {
      "type": [
        "string",
        "null"
      ],
      "description": "'General model knowledge': never cited; label it as not verified against the collection."
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "citation_id",
          "document_id",
          "document_title",
          "source_filename",
          "page_start",
          "page_end",
          "pages",
          "chunk_ids",
          "char_start",
          "char_end",
          "text_checksum_sha256",
          "quote",
          "evidence_type",
          "score",
          "rank"
        ],
        "properties": {
          "citation_id": {
            "type": "string",
            "pattern": "^S[0-9]+$",
            "description": "The id used in documents[].citation_ids."
          },
          "document_id": {
            "type": "string",
            "pattern": "^doc_[0-9a-f]{24}$"
          },
          "document_title": {
            "type": "string"
          },
          "source_filename": {
            "type": [
              "string",
              "null"
            ]
          },
          "page_start": {
            "type": "integer",
            "minimum": 1
          },
          "page_end": {
            "type": "integer",
            "minimum": 1
          },
          "pages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "page_number",
                "page_char_start",
                "page_char_end",
                "highlight_rects",
                "coordinates_reliable",
                "page_width",
                "page_height"
              ],
              "properties": {
                "page_number": {
                  "type": "integer",
                  "minimum": 1
                },
                "page_char_start": {
                  "type": "integer",
                  "minimum": 0
                },
                "page_char_end": {
                  "type": "integer",
                  "minimum": 0
                },
                "highlight_rects": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 4,
                    "maxItems": 4
                  },
                  "description": "[x0, y0, x1, y1] in PDF points, top-left origin. Draw only when coordinates_reliable is true."
                },
                "coordinates_reliable": {
                  "type": "boolean"
                },
                "page_width": {
                  "type": "number"
                },
                "page_height": {
                  "type": "number"
                }
              }
            },
            "description": "One entry per page the cited passage touches."
          },
          "chunk_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^chk_[0-9a-f]{24}$"
            }
          },
          "char_start": {
            "type": "integer",
            "minimum": 0,
            "description": "Offset into the document's canonical text stream (E2)."
          },
          "char_end": {
            "type": "integer",
            "minimum": 0
          },
          "text_checksum_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "sha256 of quote (UTF-8)."
          },
          "quote": {
            "type": "string",
            "description": "The cited passage's full text."
          },
          "evidence_type": {
            "enum": [
              "text",
              "visual"
            ]
          },
          "score": {
            "type": "number",
            "description": "Cosine similarity at retrieval, -1..1."
          },
          "rank": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "description": "Every passage supplied to the model.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "citation_id",
          "chunk_id",
          "document_id",
          "page_start",
          "page_end",
          "score",
          "rank",
          "cited"
        ],
        "properties": {
          "citation_id": {
            "type": "string"
          },
          "chunk_id": {
            "type": "string"
          },
          "document_id": {
            "type": "string"
          },
          "page_start": {
            "type": "integer"
          },
          "page_end": {
            "type": "integer"
          },
          "score": {
            "type": "number"
          },
          "rank": {
            "type": "integer"
          },
          "cited": {
            "type": "boolean"
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "model": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "model_id",
        "name",
        "quant",
        "api_version",
        "runtime_version",
        "stub"
      ],
      "properties": {
        "model_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "quant": {
          "type": [
            "string",
            "null"
          ]
        },
        "api_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "runtime_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "stub": {
          "type": "boolean"
        }
      }
    },
    "collection_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "prompt_version": {
      "type": "string"
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retrieval_ms",
        "generation_ms",
        "total_ms",
        "attempts",
        "prompt_tokens",
        "completion_tokens"
      ],
      "properties": {
        "retrieval_ms": {
          "type": "number"
        },
        "generation_ms": {
          "type": "number"
        },
        "total_ms": {
          "type": "number"
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "prompt_tokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "completion_tokens": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "error": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "hint"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "hint": {
          "type": "string"
        }
      }
    }
  }
}
