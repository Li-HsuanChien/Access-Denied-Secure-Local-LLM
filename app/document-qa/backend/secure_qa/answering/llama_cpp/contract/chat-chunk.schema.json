{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docqa.local/contract/2026-09-v1/chat-chunk.schema.json",
  "title": "POST /v1/chat/completions, stream=true: each `data:` event before [DONE]",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "object": {
      "const": "chat.completion.chunk"
    },
    "created": {
      "type": "integer"
    },
    "model": {
      "type": "string"
    },
    "system_fingerprint": {
      "type": "string"
    },
    "choices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer"
          },
          "finish_reason": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "stop",
              "length",
              null
            ]
          },
          "delta": {
            "type": "object",
            "properties": {
              "role": {
                "const": "assistant"
              },
              "content": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "logprobs": {}
        },
        "required": [
          "index",
          "delta",
          "finish_reason"
        ],
        "additionalProperties": false
      }
    },
    "usage": {
      "type": "object",
      "properties": {
        "prompt_tokens": {
          "type": "integer"
        },
        "completion_tokens": {
          "type": "integer"
        },
        "total_tokens": {
          "type": "integer"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "timings": {
      "type": "object",
      "properties": {
        "prompt_n": {
          "type": "number"
        },
        "prompt_ms": {
          "type": "number"
        },
        "prompt_per_second": {
          "type": "number"
        },
        "predicted_n": {
          "type": "number"
        },
        "predicted_ms": {
          "type": "number"
        },
        "predicted_per_second": {
          "type": "number"
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "object",
    "created",
    "model",
    "choices"
  ],
  "additionalProperties": false
}
