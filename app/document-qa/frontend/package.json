{
	"name": "access-denied-document-qa",
	"version": "0.11.4",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
		"dev:qa": "vite --host 127.0.0.1 --port 5173 --strictPort",
		"build": "vite build",
		"build:watch": "vite build --watch",
		"preview": "vite preview --host 127.0.0.1",
		"check": "tsc --noEmit",
		"check:watch": "tsc --noEmit --watch",
		"format": "prettier --write \"react/**/*.{js,ts,tsx,html}\" \"src/**/*.{js,ts,tsx,css,json}\"",
		"test:frontend": "vitest run",
		"test:host": "vitest run --config vitest.host.config.ts",
		"dev:react": "vite --host 127.0.0.1 --port 5176 --strictPort",
		"build:react": "npm run build",
		"preview:react": "npm run preview",
		"check:react": "npm run check",
		"test:react": "npm run test:frontend"
	},
	"dependencies": {
