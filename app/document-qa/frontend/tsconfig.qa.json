{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"allowJs": true,
		"checkJs": false
	},
	"include": [
		".svelte-kit/ambient.d.ts",
		".svelte-kit/env.d.ts",
		".svelte-kit/types/**/$types.d.ts",
		"src/app.d.ts",
		"src/lib/features/answering/**/*.js",
		"src/lib/features/answering/**/*.ts",
		"src/lib/features/answering/**/*.svelte"
	],
	"exclude": ["node_modules/**"]
}
