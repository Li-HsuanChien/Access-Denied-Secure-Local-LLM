{
	"compilerOptions": {
		"target": "ES2022",
		"lib": [
			"ES2022",
			"DOM",
			"DOM.Iterable"
		],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"forceConsistentCasingInFileNames": true,
		"types": [
			"vite/client",
			"node"
		],
		"baseUrl": ".",
		"paths": {
			"$lib/*": [
				"src/lib/*"
			],
			"@/*": [
				"src/*"
			]
		}
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx",
		"react/**/*.ts",
		"react/**/*.tsx"
	],
	"exclude": [
		"src/lib/apis"
	]
}
