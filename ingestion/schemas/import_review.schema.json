{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://securelocaldocqa.local/schemas/import_review/1.0.0",
  "title": "ImportReview",
  "description": "Review.to_dict(): what the review screen shows between validation and sealing (SDD 6.1). The rows are the same objects as the import report's candidates. Contains no document text.",
  "type": "object",
  "required": [
    "attempt_id",
    "state",
    "requires_confirmation",
    "confirmation_token",
    "totals",
    "candidates"
  ],
  "additionalProperties": false,
  "properties": {
    "attempt_id": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "enum": [
        "ready",
        "awaiting_confirmation",
        "nothing_accepted"
      ],
      "description": "ready: commit() needs nothing. awaiting_confirmation: commit() needs confirmation_token. nothing_accepted: commit() refuses."
    },
    "requires_confirmation": {
      "type": "boolean"
    },
    "confirmation_token": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^ack_[0-9a-f]{16}$"
    },
    "totals": {
      "$ref": "https://securelocaldocqa.local/schemas/import_report/1.0.0#/properties/summary"
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://securelocaldocqa.local/schemas/import_report/1.0.0#/$defs/candidate"
      }
    }
  }
}
