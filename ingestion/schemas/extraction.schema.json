{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://securelocaldocqa.local/schemas/extraction/1.0.0",
  "title": "Extraction",
  "description": "Extraction metadata for one document (SDD 5): where each page sits in the canonical text stream. Lets a consumer map any stream offset to a page, and lets verify() check every chunk's page spans, without reopening the PDF. Contains no document text.",
  "type": "object",
  "required": ["schema_version", "document_id", "extractor", "chunker_config_id", "text_chars", "text_sha256", "pages"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "document_id": { "type": "string", "pattern": "^doc_[0-9a-f]{24}$" },
    "extractor": { "type": "string" },
    "chunker_config_id": { "type": "string", "pattern": "^cfg_[0-9a-f]{12}$" },
    "text_chars": { "type": "integer", "minimum": 1 },
    "text_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "pages": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["page_number", "char_start", "char_end", "width", "height", "has_text", "spans"],
        "additionalProperties": false,
        "properties": {
          "page_number": { "type": "integer", "minimum": 1 },
          "char_start": { "type": "integer", "minimum": 0 },
          "char_end": { "type": "integer", "minimum": 0 },
          "width": { "type": "number", "exclusiveMinimum": 0 },
          "height": { "type": "number", "exclusiveMinimum": 0 },
          "has_text": { "type": "boolean" },
          "spans": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
